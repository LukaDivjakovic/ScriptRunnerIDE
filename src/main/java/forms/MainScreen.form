<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="forms.MainScreen">
  <grid id="27dc6" binding="contentPane" layout-manager="BorderLayout" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="toolbar" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a07df" class="javax.swing.JLabel" binding="statusLabel">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Ready"/>
            </properties>
          </component>
          <component id="aab02" class="javax.swing.JButton" binding="runButton" default-binding="true">
            <constraints border-constraint="East"/>
            <properties>
              <text value="Run"/>
            </properties>
          </component>
        </children>
      </grid>
      <splitpane id="mainSplit" layout-manager="GridLayoutManager">
        <constraints border-constraint="Center"/>
        <properties>
          <dividerLocation value="500"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="42055" class="javax.swing.JTextPane" binding="editPane">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
          </component>
          <splitpane id="rightSplit" layout-manager="GridLayoutManager" orientation="1">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties>
              <dividerLocation value="300"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="b3a6f" class="javax.swing.JTextPane" binding="outputPane">
                <constraints>
                  <splitpane position="left"/>
                </constraints>
                <properties/>
              </component>
              <component id="e037b" class="javax.swing.JTextPane" binding="errorPane">
                <constraints>
                  <splitpane position="right"/>
                </constraints>
                <properties/>
              </component>
            </children>
          </splitpane>
        </children>
      </splitpane>
    </children>
  </grid>
</form>
